{
  "name": "ev-brasil",
  "version": "1.0.0",
  "description": "Site de venda de veículos elétricos para o Brasil — HTML/CSS/JavaScript puro.",
  "private": true,
  "scripts": {
    "start": "npx serve .",
    "dev": "npx serve .",
    "deploy": "firebase deploy --only hosting",
    "dados": "node scripts/gerar-dados.mjs && node scripts/gerar-paginas.mjs",
    "imagens": "node scripts/gerar-imagens.mjs",
    "og": "node scripts/gerar-og.mjs",
    "precos": "node scripts/conferir-precos.mjs",
    "fipe": "node scripts/coletar-fipe.mjs"
