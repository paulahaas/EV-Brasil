rules_version = '2';

// O site virou um guia de pesquisa e não usa mais o banco: anúncios, contas e
// formulário de contato foram removidos. Tudo fica fechado, inclusive leitura,
// para que os dados antigos (que têm WhatsApp e e-mail de pessoas) não fiquem públicos.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
