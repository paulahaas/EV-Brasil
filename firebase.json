{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "serve.json",
      "package.json",
      "package-lock.json",
      "README.md",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "dados/**",
      "scripts/**",
      "previa-pesquisa/**",
      "previa-fotos/**",
      "previa-visual/**",
      "previa-fotos2/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
